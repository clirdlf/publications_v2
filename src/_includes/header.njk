<header class="lp-site-header" id="top">
  <div class="lp-utility-bar">
    <div class="lp-container lp-utility-bar-inner">
      <nav class="lp-utility-nav" aria-label="CLIR network">
        <a href="https://www.diglib.org/" target="_blank" rel="noopener noreferrer">DLF</a>
        <a href="https://www.clir.org/grants/" target="_blank" rel="noopener noreferrer">Grants</a>
        <a href="https://jobs.diglib.org/" target="_blank" rel="noopener noreferrer">Job Board</a>
      </nav>
    </div>
  </div>

  <div class="lp-topbar">
    <div class="lp-container lp-topbar-inner">
      <a class="lp-brand" href="{{ '/' | url }}" aria-label="CLIR Publications home">
        <img
          class="lp-brand-logo"
          src="{{ '/assets/logos/CLIR-logo-bounded-red-hairline.svg' | url }}"
          alt="CLIR"
          width="126"
          height="64.76"
        />
        <span class="lp-brand-section">Publications</span>
      </a>

      <button
        class="lp-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="lp-mobile-nav"
        aria-label="Open publications menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="lp-nav-panel" id="lp-mobile-nav">
        <nav class="lp-main-nav" aria-label="Publications">
          <a href="{{ '/reports/' | url }}"{% if navPage == "reports" %} aria-current="page"{% endif %}>Reports</a>
          <a href="{{ '/podcasts/' | url }}"{% if navPage == "podcasts" %} aria-current="page"{% endif %}>Podcasts</a>
          <a href="{{ '/videos/' | url }}"{% if navPage == "videos" %} aria-current="page"{% endif %}>Videos</a>
          <a href="{{ '/about/' | url }}"{% if navPage == "about" %} aria-current="page"{% endif %}>About</a>
          <a class="lp-main-site-link" href="https://dev.clir.org/clir/">Main CLIR site <span aria-hidden="true">↗</span></a>
          <a class="lp-mobile-search-link" href="{{ '/search/' | url }}">Search</a>
        </nav>
      </div>

      <div class="lp-header-actions">
        <form class="lp-header-search-form" role="search" method="get" action="{{ '/search/' | url }}">
          <div class="lp-header-search-box">
            <button
              class="lp-header-search"
              type="button"
              aria-label="Open publication search"
              aria-expanded="false"
              aria-keyshortcuts="Control+K Meta+K"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="m16 16 4.25 4.25"></path>
              </svg>
            </button>
            <label class="sr-only" for="lp-header-search-input">Search publications</label>
            <input
              class="lp-header-search-input"
              id="lp-header-search-input"
              type="search"
              name="q"
              placeholder="Search publications..."
              autocomplete="off"
            />
          </div>
        </form>
        <a
          class="lp-header-donate"
          href="https://www.clir.org/support/give/"
          target="_blank"
          rel="noopener noreferrer"
        >Donate</a>
      </div>
    </div>
  </div>
</header>
