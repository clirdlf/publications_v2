---
layout: base.njk
title: Material Memory Podcast - CLIR Publications
permalink: "/podcasts/"
description: Listen to podcast episodes from CLIR.
navPage: podcasts
---
{% from "media-browser.njk" import mediaBrowserHeader, mediaBrowserEmpty %}

<section class="lp-hero">
  <div class="lp-container lp-hero-inner">
    <p class="eyebrow">Featured collection</p>
    <h1>Material Memory Podcast</h1>
    <p>
      Listen to Material Memory, featuring stories from archives, libraries, and cultural memory
      communities.
    </p>
    <p><a class="button button-primary" href="https://pod.link/1488667989" target="_blank" rel="noopener noreferrer">Follow the podcast</a></p>
  </div>

</section>

<section class="lp-section lp-section-alt lp-section-audio">
  <div class="lp-container" data-media-browser>
    {{ mediaBrowserHeader("Explore the episodes", "Search episodes") }}
    <div class="lp-grid lp-grid-reports">
      {% for episode in podcastCards %}
        <article class="lp-card lp-media-card lp-podcast-card" data-media-item data-title="{{ episode.title }}" data-description="{{ episode.summary }}" data-date="{{ episode.date }}">
          {% if episode.image %}
            <div class="lp-media">
              {% image episode.image, "Cover art for " + episode.title, "(max-width: 760px) 100vw, 300px", [300, 600], "lp-media-image" %}
            </div>
          {% endif %}
          <div class="lp-card-body">
            <h3><a href="{{ episode.detailPath | url }}">{{ episode.title }}</a></h3>
            <p class="lp-podcast-meta">
              <time datetime="{{ episode.date }}">{{ episode.publishedLabel }}</time>{% if episode.season %}<span>Season {{ episode.season }}{% if episode.episode %}, episode {{ episode.episode }}{% endif %}</span>{% endif %}{% if episode.duration %}<span>{{ episode.duration }}</span>{% endif %}
            </p>
            {% if episode.summary %}<p>{{ episode.summary }}</p>{% endif %}
            {% if episode.enclosureUrl %}
              <audio controls preload="none" class="lp-podcast-player" aria-label="Play {{ episode.title }}">
                <source src="{{ episode.enclosureUrl }}" type="{{ episode.enclosureType or 'audio/mpeg' }}" />
                Your browser does not support the audio player.
              </audio>
            {% endif %}
            <a class="button button-secondary button-compact" href="{{ episode.detailPath | url }}">Episode details{% if episode.transcriptUrl %} and transcript{% endif %}</a>
          </div>
        </article>
      {% else %}
        <article class="lp-card rp-card">
          <div class="lp-card-body">
            <h3>No podcast episodes found.</h3>
            <p>No episodes are currently available.</p>
          </div>
        </article>
      {% endfor %}
    </div>
    {{ mediaBrowserEmpty("No episodes match your search.") }}
  </div>
</section>
