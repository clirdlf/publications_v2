---
layout: reports-page.njk
title: Material Memory Podcast - CLIR Publications
permalink: "/podcasts/"
description: Listen to podcast episodes from CLIR.
navPage: podcasts
---
{% set episodes = podcast or [] %}

<section class="lp-hero">
  <div class="lp-container lp-hero-inner">
    <p class="lp-hero-eyebrow">Featured Collection</p>
    <h1>Material Memory Podcast</h1>
    <p>
      Listen to Material Memory, featuring stories from archives, libraries, and cultural memory
      communities.
    </p>
    <p><a class="lp-btn" href="https://pod.link/1488667989" target="_blank" rel="noopener noreferrer">Follow the podcast</a></p>
  </div>
</section>

<section class="lp-section lp-section-alt lp-section-audio">
  <div class="lp-container" data-media-browser>
    <div class="media-collection-heading">
      <div>
        <p class="lp-section-eyebrow">Browse the collection</p>
        <h2>Explore the episodes</h2>
      </div>
      <div class="media-controls">
        <label>Search episodes <input type="search" placeholder="Title or description" data-media-search></label>
        <label>Sort <select data-media-sort><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title</option></select></label>
      </div>
    </div>
    <p class="media-results-status" data-media-status aria-live="polite"></p>
    <div class="lp-grid lp-grid-reports">
      {% for episode in episodes %}
        {% set summary = episode.description | stripHtml | normalizeWhitespace | snippet(170) %}
        {% set episodeSlug = episode.slug or ((episode.title + '-' + episode.pubDate) | slugify) %}
        {% set episodeUrl = ('/items/podcast-' + episodeSlug + '/') | url %}
        <article class="lp-card lp-media-card lp-podcast-card" data-media-item data-title="{{ episode.title }}" data-description="{{ summary }}" data-date="{{ episode.pubDate | isoDate }}">
          {% if episode.image %}
            <div class="lp-media">
              {% image episode.image, "Cover art for " + episode.title, "(max-width: 760px) 100vw, 300px", [300, 600], "lp-media-image" %}
            </div>
          {% endif %}
          <div class="lp-card-body">
            <h3><a href="{{ episodeUrl }}">{{ episode.title }}</a></h3>
            <p class="lp-podcast-meta">
              <time datetime="{{ episode.pubDate | isoDate }}">{{ episode.pubDate | prettyDate }}</time>{% if episode.season %}<span>Season {{ episode.season }}{% if episode.episode %}, episode {{ episode.episode }}{% endif %}</span>{% endif %}{% if episode.duration %}<span>{{ episode.duration }}</span>{% endif %}
            </p>
            {% if summary %}<p>{{ summary }}</p>{% endif %}
            {% if episode.enclosureUrl %}
              <audio controls preload="none" class="lp-podcast-player" aria-label="Play {{ episode.title }}">
                <source src="{{ episode.enclosureUrl }}" type="{{ episode.enclosureType or 'audio/mpeg' }}" />
                Your browser does not support the audio player.
              </audio>
            {% endif %}
            <a class="lp-btn lp-btn-small" href="{{ episodeUrl }}">Episode details{% if episode.transcriptUrl %} and transcript{% endif %}</a>
          </div>
        </article>
      {% else %}
        <article class="lp-card rp-card">
          <div class="lp-card-body">
            <h3>No podcast episodes found.</h3>
            <p>No episodes are currently available.</p>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="media-empty" data-media-empty hidden>No episodes match your search.</div>
  </div>
</section>
