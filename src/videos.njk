---
layout: base.njk
title: Videos - CLIR Publications
permalink: "/videos/"
description: Watch videos from CLIR and DLF.
navPage: videos
---
{% from "media-browser.njk" import mediaBrowserHeader, mediaBrowserEmpty %}

<section class="lp-hero">
  <div class="lp-container lp-hero-inner">
    <p class="eyebrow">Featured collection</p>
    <h1>Videos</h1>
    <p>Explore talks, webinars, and updates from CLIR and DLF.</p>
    <p><a class="button button-primary" href="https://www.youtube.com/@DLFCLIR" target="_blank" rel="noopener noreferrer">Visit the YouTube channel</a></p>
  </div>
</section>

<section class="lp-section lp-section-alt">
  <div class="lp-container" data-media-browser>
    {{ mediaBrowserHeader("Watch recent videos", "Search videos", "Watch recent talks, webinars, and conversations from CLIR and the Digital Library Federation. Visit YouTube for the complete archive.") }}
    <div class="lp-grid lp-grid-reports">
      {% for video in videoCards %}
        <article class="lp-card lp-media-card" data-media-item data-title="{{ video.title }}" data-description="{{ video.summary }}" data-date="{{ video.date }}">
          <a class="lp-media-link" href="{{ video.detailPath | url }}" aria-label="View details for {{ video.title }}">
            <div class="lp-media lp-media-play">
              {% if video.thumbnail %}
                {% image video.thumbnail, "", "(max-width: 760px) 100vw, 300px", [320, 640, 960], "lp-media-image" %}
              {% endif %}
            </div>
          </a>
          <div class="lp-card-body">
            <h3><a href="{{ video.detailPath | url }}">{{ video.title }}</a></h3>
            {% if video.date %}<p class="lp-podcast-meta"><time datetime="{{ video.date }}">{{ video.publishedLabel }}</time></p>{% endif %}
            {% if video.summary %}<p>{{ video.summary }}</p>{% endif %}
            <a class="button button-secondary button-compact" href="{{ video.detailPath | url }}">Video details</a>
          </div>
        </article>
      {% else %}
        <article class="lp-card rp-card">
          <div class="lp-card-body">
            <h3>No videos found.</h3>
            <p>No videos are currently available.</p>
          </div>
        </article>
      {% endfor %}
    </div>
    {{ mediaBrowserEmpty("No videos match your search.") }}
  </div>
</section>
