---
layout: reports-page.njk
title: Videos - CLIR Publications
permalink: "/videos/"
description: Watch videos from CLIR and DLF.
navPage: videos
---
{% set videos = youtube or [] %}

<section class="lp-hero">
  <div class="lp-container lp-hero-inner">
    <p class="lp-hero-eyebrow">Featured Collection</p>
    <h1>Videos</h1>
    <p>Explore talks, webinars, and updates from CLIR and DLF.</p>
    <p><a class="lp-btn" href="https://www.youtube.com/@DLFCLIR" target="_blank" rel="noopener noreferrer">Visit the YouTube channel</a></p>
  </div>
</section>

<section class="lp-section lp-section-alt">
  <div class="lp-container" data-media-browser>
    <div class="media-collection-heading">
      <div><p class="lp-section-eyebrow">Browse the collection</p><h2>{{ videos | length }} recent videos</h2></div>
      <div class="media-controls">
        <label>Search videos <input type="search" placeholder="Title or description" data-media-search></label>
        <label>Sort <select data-media-sort><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title</option></select></label>
      </div>
    </div>
    <p class="media-archive-note">This page contains the videos available from YouTube’s recent-upload feed. Visit the channel for the complete archive.</p>
    <p class="media-results-status" data-media-status aria-live="polite"></p>
    <div class="lp-grid lp-grid-reports">
      {% for video in videos %}
        {% set summary = video.description | normalizeWhitespace | snippet(170) %}
        {% set videoSlug = video.slug or ((video.title + '-' + video.videoId) | slugify) %}
        {% set videoUrl = ('/items/video-' + videoSlug + '/') | url %}
        <article class="lp-card lp-media-card" data-media-item data-title="{{ video.title }}" data-description="{{ summary }}" data-date="{{ video.published | isoDate }}">
          <a class="lp-media-link" href="{{ videoUrl }}" aria-label="View details for {{ video.title }}">
            <div class="lp-media lp-media-play">
              {% if video.thumbnail %}
                {% image video.thumbnail, "", "(max-width: 760px) 100vw, 300px", [320, 640, 960], "lp-media-image" %}
              {% endif %}
            </div>
          </a>
          <div class="lp-card-body">
            <h3><a href="{{ videoUrl }}">{{ video.title }}</a></h3>
            {% if video.published %}<p class="lp-podcast-meta"><time datetime="{{ video.published | isoDate }}">{{ video.published | prettyDate }}</time></p>{% endif %}
            {% if summary %}<p>{{ summary }}</p>{% endif %}
            <a class="lp-btn lp-btn-small" href="{{ videoUrl }}">Video details</a>
          </div>
        </article>
      {% else %}
        <article class="lp-card rp-card">
          <div class="lp-card-body">
            <h3>No videos found.</h3>
            <p>No videos are currently available.</p>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="media-empty" data-media-empty hidden>No videos match your search.</div>
  </div>
</section>
