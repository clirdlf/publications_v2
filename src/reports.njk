---
layout: reports-page.njk
title: Reports - CLIR Publications
description: Browse CLIR reports by title, author, category, and publication date.
navPage: reports
reportsBrowser: true
---
{% set reports = zenodo or [] %}

<section class="rp-hero">
  <div class="lp-container">
    <p class="rp-eyebrow">Reports Library</p>
    <h1>Browse CLIR Reports</h1>
    <p>
      Search across reports, choose how they are sorted, and open any report in the item view.
    </p>
    <p><a class="lp-btn" href="{{ '/annual-reports/' | url }}">Featured Collection: Annual Reports</a></p>
  </div>
</section>

<section class="rp-browser-wrap">
  <div class="lp-container" data-reports-browser>
    <details class="rp-filter-panel" data-reports-filter-panel open>
      <summary>Search and sort</summary>
      <div class="rp-controls">
      <label class="rp-control rp-control-search">
        <span>Search</span>
        <input
          type="search"
          placeholder="Search title, author, or summary"
          data-reports-search
        />
      </label>

      {# <label class="rp-control">
        <span>Category</span>
        <input
          type="search"
          placeholder="All categories"
          list="reports-categories"
          autocomplete="off"
          data-reports-category
        />
        <datalist id="reports-categories" data-reports-category-list></datalist>
      </label> #}

      <label class="rp-control">
        <span>Sort</span>
        <select data-reports-sort>
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="title-asc">Title A-Z</option>
          <option value="title-desc">Title Z-A</option>
        </select>
      </label>

      <label class="rp-control">
        <span>Per page</span>
        <select data-reports-page-size>
          <option value="12">12</option>
          <option value="24">24</option>
          <option value="48">48</option>
        </select>
      </label>
      </div>
    </details>

    <div class="rp-feedback">
      <p class="rp-status" data-reports-status role="status" aria-live="polite"></p>
      <button class="rp-clear" type="button" data-reports-clear hidden>Clear all filters</button>
    </div>
    <div class="rp-active-filters" data-reports-active-filters aria-label="Active filters"></div>

    <ul class="rp-results" data-reports-list>
      {% for r in reports %}
        {% set authors = "" %}
        {% if r.creators and r.creators.length %}
          {% set authors = r.creators | join(", ") %}
        {% endif %}
        {% set summaryText = r.description | stripHtml | normalizeWhitespace %}
        {% set summarySnippet = summaryText | snippet(190) %}
        {% set categories = "" %}
        {% if r.keywords and r.keywords.length %}
          {% set categories = r.keywords | join("|") %}
        {% endif %}
        {% set thumbnail250 = r.links and r.links.thumbnails and (r.links.thumbnails["250"] or r.links.thumbnails["100"]) %}
        {% set thumbnail750 = r.links and r.links.thumbnails and (r.links.thumbnails["750"] or thumbnail250) %}
        <li
          class="rp-card{% if thumbnail250 %} rp-card-with-cover{% endif %}"
          data-report-card
          data-title="{{ r.title }}"
          data-published="{{ r.published }}"
          data-categories="{{ categories }}"
          data-searchable="{{ r.title }} {{ authors }} {{ summaryText }}"
        >
          {% if thumbnail250 %}
            <div class="rp-card-cover" aria-hidden="true">
              <img
                src="{{ thumbnail250 }}"
                srcset="{{ thumbnail250 }} 250w, {{ thumbnail750 }} 750w"
                sizes="(max-width: 760px) 72px, 132px"
                alt=""
                width="250"
                height="333"
                loading="{% if loop.index <= 2 %}eager{% else %}lazy{% endif %}"
                {% if loop.index <= 2 %}fetchpriority="high"{% endif %}
                decoding="async"
              />
            </div>
          {% endif %}
          <div class="rp-card-content">
            <h2>
              <a href="{{ ('/reports/zenodo-' + r.zenodo_id + '/') | url }}">{{ r.title }}</a>
            </h2>
            <dl class="rp-meta">
              <div>
                <dt>Date</dt>
                <dd><time datetime="{{ r.published | isoDate }}">{{ r.published | prettyDate }}</time></dd>
              </div>
              <div>
                <dt>Author</dt>
                <dd>
                  {% if r.creators and r.creators.length %}
                    {{ authors }}
                  {% else %}
                    Unknown author
                  {% endif %}
                </dd>
              </div>
            </dl>
            <p class="rp-summary">{{ summarySnippet or "No summary available." }}</p>
          </div>
        </li>
      {% endfor %}
    </ul>

    <div class="rp-empty" data-reports-empty hidden>
      <h2>No matching reports</h2>
      <p>Try a broader search, choose another category, or clear your filters.</p>
      <button type="button" data-reports-empty-clear>Reset search and filters</button>
    </div>

    <nav class="rp-pagination" aria-label="Reports pages">
      <button type="button" data-reports-prev>Previous</button>
      <p data-reports-page>Page 1 of 1</p>
      <div class="rp-page-numbers" data-reports-pages></div>
      <button type="button" data-reports-next>Next</button>
    </nav>
  </div>
</section>
